# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/currency_alerts

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=alerts@yourdomain.com

# Alert System Configuration
ALERT_CHECK_INTERVAL=300  # Check alerts every 5 minutes
ALERT_COOLDOWN_HOURS=1    # Minimum time between notifications for same alert

# Stripe Configuration (if using billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STARTER_PRICE_ID=
PRO_PRICE_ID=
SCALE_PRICE_ID=

# Redis Configuration (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# Admin Configuration
ADMIN_TOKEN=your_secure_admin_token_here

# Feature Flags
FORECAST_FEATURE_FLAG=true
