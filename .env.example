# Frontend Environment Variables Example
# Copy this file to .env and fill in your values

# API Base URL - Points to Netlify Functions
VITE_API_BASE=/.netlify/functions

# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-4QQQGLR7SC

# Cookiebot ID
VITE_COOKIEBOT_ID=a316e185-0703-4964-b697-d0301f10cdb9

# Feature Flags
VITE_ENABLE_CRYPTO=true
VITE_ENABLE_ALERTS=true
VITE_ENABLE_FORECASTS=true

# Development Settings
VITE_DEBUG_MODE=false

