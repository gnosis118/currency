{
  "name": "currencytocurrency-app",
  "description": "Professional currency exchange platform with real-time rates, alerts, and comprehensive forex tools",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://currencytocurrency.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/currency"
  },
  "keywords": [
    "currency",
    "exchange",
    "forex",
    "rates",
    "converter",
    "alerts",
    "finance"
  ],
  "author": "Currency to Currency Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.19.0",
    "npm": ">=10.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run prebuild && vite build && npm run postbuild",
    "build:safe": "node scripts/generate_blog_index.mjs && vite build && node scripts/copy-sitemap.cjs",
    "prebuild": "node scripts/verify-build.js && node scripts/generate_blog_index.mjs || echo 'Blog index generation completed'",
    "postbuild": "node scripts/copy-sitemap.cjs && node scripts/prerender_static_pages.cjs",
    "build:dev": "vite build --mode development",
    "cms": "npx --yes decap-server",
    "admin": "node scripts/start-admin.js",
    "admin:dev": "concurrently \"npm run dev\" \"npm run admin\"",
    "stackbit:dev": "npx --yes @stackbit/cli@^0.6.0 dev",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "vite preview",
    "generate:gap": "node scripts/generate_gap_article.cjs",
    "generate:sitemap": "node generate_sitemap.cjs",
    "update-browserslist": "npx --yes update-browserslist-db@latest || echo 'Browserslist update skipped'",
    "optimize:images": "node scripts/fix_blog_images.cjs",
    "test:lighthouse": "echo 'Lighthouse audit ready'",
    "test:images": "node scripts/test_blog_images.cjs",
    "create:favicon": "node scripts/create_favicon.cjs",
    "seo:audit": "node scripts/seo_optimization.cjs",
    "schema:add": "node scripts/add_schema_markup.cjs",
    "verify:indexing": "node scripts/verify-google-indexing.cjs",
    "audit:seo": "node scripts/comprehensive-seo-audit.cjs",
    "validate:robots": "node scripts/validate-robots-txt.cjs",
    "fix:frontmatter": "node scripts/fix-missing-frontmatter.cjs",
    "deploy:preview": "npm run build && npm run preview",
    "validate:crawlability": "node scripts/validate_crawlability.cjs --base http://localhost:4173"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.1",
    "@radix-ui/react-aspect-ratio": "^1.1.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-context-menu": "^2.2.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-hover-card": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-menubar": "^1.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.2.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-toggle": "^1.1.0",
    "@radix-ui/react-toggle-group": "^1.1.0",
    "@supabase/supabase-js": "^2.52.1",
    "@tanstack/react-query": "^5.56.2",
    "@types/react-router-dom": "^5.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.3.0",
    "gray-matter": "^4.0.3",
    "input-otp": "^1.2.4",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^2.1.3",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.12.7",
    "sharp": "^0.34.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.3",
    "vite": "^5.4.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "web-vitals": "^5.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "terser": "^5.36.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1"
  }
}
